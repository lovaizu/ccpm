[run]
branch = true
patch = subprocess
parallel = true
# pytest's own process hands each test to its workers and runs no code of the plugins, so it has
# nothing to count; the workers count it all.
disable_warnings = no-data-collected

[report]
show_missing = true
fail_under = 100
# rn's copies of the old Turn's call.py, forms.py and parts.py, which rn 0.8.0 takes in: the old
# Turn's tests ran them in full through its turn.py, gone as Turn is rebuilt (T41), and rn's own
# tests run only what rn calls of them; rn's rebuild (T46, .rn/20261013-rebuild/steering.md)
# replaces them, and these go then.
omit =
    plugins/rn/scripts/call.py
    plugins/rn/scripts/forms.py
    plugins/rn/scripts/parts.py
