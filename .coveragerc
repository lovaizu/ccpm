[run]
branch = true
patch = subprocess
parallel = true

[report]
show_missing = true
fail_under = 100
# turn's scripts that only turn's old tests ran in full, skipped as they read lane's code by its old
# paths; turn is rebuilt from zero in T41 (.rn/20261013-rebuild/steering.md), and these go then.
omit =
    plugins/turn/scripts/forms.py
    plugins/turn/scripts/items.py
    plugins/turn/scripts/parts.py
