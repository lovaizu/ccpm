{
  "subagents": [
    {
      "name": "up",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "start_with",
              "takes": [
                "lay.py up"
              ]
            }
          ]
        },
        {
          "step": 3,
          "lanes": [
            {
              "lane": "read_only",
              "takes": [
                "{reads}"
              ]
            }
          ]
        },
        {
          "step": 7,
          "lanes": [
            {
              "lane": "as_printed",
              "takes": [
                "lay.py print"
              ]
            }
          ]
        },
        {
          "step": 9,
          "lanes": [
            {
              "lane": "wait_for",
              "takes": [
                "OK",
                "lay.py write"
              ]
            }
          ]
        }
      ]
    }
  ]
}
