{
  "description": "turn: keeps the calling AI's call, the orchestrator and each role of a run to their steps, and the repository as the calling AI left it. Without python3 the checks do not run; the orchestrator's first step stops the run and says to install it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Bash|Write|Edit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/scripts${PYTHONPATH:+:$PYTHONPATH}\" exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/scripts${PYTHONPATH:+:$PYTHONPATH}\" exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/subagentstop.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
