{
  "title": "The generator's claim: each item's Good with its lines, or the question it waits on; asking before it makes anything, the items waiting alone.",
  "type": "object",
  "required": [
    "items",
    "questions"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "checklist",
        "item"
      ],
      "properties": {
        "checklist": {
          "type": "string"
        },
        "item": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "question",
        "recommended"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "recommended": {
          "type": "string"
        }
      }
    }
  }
}
