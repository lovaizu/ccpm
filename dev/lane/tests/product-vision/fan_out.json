{"plugin": "changelog",
 "subagents": [
  {"name": "writer", "steps": [
   {"step": 2, "lanes": [{"lane": "run_only", "takes": ["git log --oneline"]}]},
   {"step": 3, "lanes": [{"lane": "write_only", "takes": ["CHANGELOG.md"]}]}]},
  {"name": "auditor", "steps": [
   {"step": 2, "lanes": [{"lane": "run_only", "takes": ["python3 ${CLAUDE_PLUGIN_ROOT}/scripts/commits.py {part}"]}]}]}],
 "routes": {"orchestrator": "write", "step": 1, "fan_out": ["auditor"], "precedence": ["more", "good"],
  "routes": [
   {"from": "write", "to": "auditor"},
   {"from": "auditor", "on": "more", "to": "writer"},
   {"from": "auditor", "on": "good"},
   {"from": "writer", "on": "written"}]}}
