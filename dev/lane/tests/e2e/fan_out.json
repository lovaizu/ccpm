{"plugin": "changelog",
 "subagents": [
  {"name": "writer", "steps": [
   {"step": 2, "lanes": [{"lane": "run_only", "takes": ["git log --oneline"]}]},
   {"step": 3, "lanes": [{"lane": "write_only", "takes": ["CHANGELOG.md"]}]}]},
  {"name": "reviewer", "steps": [
   {"step": 2, "lanes": [{"lane": "run_only", "takes": ["git log --oneline"]}]}]}],
 "routes": {"orchestrator": "lead", "step": 1, "fan_out": ["reviewer"], "precedence": ["more", "good"],
  "routes": [
   {"from": "lead", "to": "reviewer"},
   {"from": "reviewer", "on": "more", "to": "writer"},
   {"from": "reviewer", "on": "good"},
   {"from": "writer", "on": "written"}]}}
