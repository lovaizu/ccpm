{"event": "herdr worktree open opens the worktree in a workspace", "command": "herdr worktree open --cwd {repository} --path {path} --no-focus", "exit": 0, "stdout": "{\"id\":\"cli:worktree:open\",\"result\":{\"already_open\":false,\"root_pane\":{\"agent_status\":\"unknown\",\"cwd\":\"{path}\",\"focused\":false,\"foreground_cwd\":\"{path}\",\"pane_id\":\"{workspace}:p1\",\"revision\":0,\"scroll\":{\"max_offset_from_bottom\":0,\"offset_from_bottom\":0,\"viewport_rows\":63},\"tab_id\":\"{workspace}:t1\",\"terminal_id\":\"{terminal}\",\"workspace_id\":\"{workspace}\"},\"tab\":{\"agent_status\":\"unknown\",\"focused\":false,\"label\":\"1\",\"number\":1,\"pane_count\":1,\"tab_id\":\"{workspace}:t1\",\"workspace_id\":\"{workspace}\"},\"type\":\"worktree_opened\",\"workspace\":{\"active_tab_id\":\"{workspace}:t1\",\"agent_status\":\"unknown\",\"focused\":false,\"label\":\"{label}\",\"number\":6,\"pane_count\":1,\"tab_count\":1,\"workspace_id\":\"{workspace}\",\"worktree\":{\"checkout_path\":\"{path}\",\"is_linked_worktree\":true,\"repo_key\":\"{repository}/.git\",\"repo_name\":\"ccpm\",\"repo_root\":\"{repository}\"}},\"worktree\":{\"branch\":\"{branch}\",\"is_bare\":false,\"is_detached\":false,\"is_linked_worktree\":true,\"is_prunable\":false,\"label\":\"ccpm\",\"open_workspace_id\":\"{workspace}\",\"path\":\"{path}\"}}}\n", "stderr": ""}
{"event": "herdr worktree list lists the repository's worktrees", "command": "herdr worktree list --cwd {repository}", "exit": 0, "stdout": "{\"id\":\"cli:worktree:list\",\"result\":{\"source\":{\"repo_key\":\"{repository}/.git\",\"repo_name\":\"ccpm\",\"repo_root\":\"{repository}\",\"source_checkout_path\":\"{repository}\",\"source_workspace_id\":\"w1\"},\"type\":\"worktree_list\",\"worktrees\":[\"{worktrees}\"]}}\n", "stderr": "", "worktree": {"branch": "{branch}", "is_bare": false, "is_detached": false, "is_linked_worktree": true, "is_prunable": false, "label": "ccpm", "open_workspace_id": "{workspace}", "path": "{path}"}}
{"event": "herdr worktree remove removes the worktree of the workspace", "command": "herdr worktree remove --workspace {workspace} --force", "exit": 0, "stdout": "{\"id\":\"cli:worktree:remove\",\"result\":{\"forced\":true,\"path\":\"{path}\",\"type\":\"worktree_removed\",\"workspace_id\":\"{workspace}\"}}\n", "stderr": ""}
{"event": "herdr worktree remove finds no such workspace", "command": "herdr worktree remove --workspace w999", "exit": 1, "stdout": "", "stderr": "{\"error\":{\"code\":\"workspace_not_found\",\"message\":\"workspace {workspace} not found\"},\"id\":\"cli:worktree:remove\"}\n"}
{"event": "herdr worktree list can't list the worktrees", "command": "herdr worktree list --cwd /tmp", "exit": 1, "stdout": "", "stderr": "{\"error\":{\"code\":\"not_git_worktree\",\"message\":\"Herdr worktree actions require a path inside a Git work tree\"},\"id\":\"cli:worktree:list\"}\n"}
