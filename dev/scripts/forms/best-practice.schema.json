{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "best practice",
  "description": "A kind's best practice. It holds its goal, and may hold the critical success factors, the few things that must go right for the deliverable's role to reach that goal. It names the template beside it, which holds the form a good deliverable of the kind takes, or else the parts such a deliverable has. It names the example beside it, one deliverable made by it, and the deliverable the example copies, if it copies one, by its path from the best practice's folder. It names the kinds such a deliverable takes its content from, in inputs, and those whose deliverables must pass before it starts, in preconditions, each by the name of its best practice's folder. It holds the necessary conditions, each a state of the deliverable that a critical success factor needs, written as a question such a deliverable answers yes to, and a practice for each: its thinking, what to do and why, and its steps where it needs them, each with the call that shows it done where every run makes one. An evaluator gets its goal, its critical success factors, its parts, and its necessary conditions alone.",
  "type": "object",
  "required": [
    "goal",
    "inputs",
    "preconditions",
    "necessary_conditions",
    "practices"
  ],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "example": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "critical_success_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "necessary_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "csf": {
            "type": "string"
          },
          "about": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "practices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "thinking",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string"
          },
          "thinking": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "trace": {
                  "description": "The call that shows the step done, which Lane holds the step by as a lane of the trace kind: a command run, matched whole, a file read to its end, or a file made, each take one such call. Lane counts the step done once one command taken comes back, once the role makes one file taken, or once it reads each file taken to its end. A step whose trace not every run makes carries none.",
                  "type": "object",
                  "required": [
                    "action",
                    "takes"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "enum": [
                        "run",
                        "read",
                        "write"
                      ]
                    },
                    "takes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inner"
          }
        }
      }
    },
    "inner": {
      "description": "A part inside a part. Structured outputs take no schema that comes back to itself, so parts nest three deep at most.",
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leaf"
          }
        }
      }
    },
    "leaf": {
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        }
      }
    }
  }
}
