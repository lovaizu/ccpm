#!/bin/sh
# Before a push, the checks of what the push changes, on the commits pushed: `sh dev/check.sh`, the
# property tests on few inputs and the mutation testing of the lines changed, for each plugin
# `sh dev/changed.sh` names; CI checks again. Turned on in a clone by
# `git config core.hooksPath dev/githooks`, with the tools of dev/requirements.txt and
# dev/requirements-test-quality.txt first on PATH.
set -e

if ! command -v cosmic-ray >/dev/null 2>&1; then
  echo "pre-push: the check tools are not on PATH; make the virtual environment dev/README.md names and put its bin first" >&2
  exit 1
fi
zero=0000000000000000000000000000000000000000
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue
  if [ "$remote" = "$zero" ]; then
    base=$(git merge-base "$local" origin/main)
  else
    base=$remote
  fi
  plugins=$(sh dev/changed.sh "$base" "$local")
  [ -n "$plugins" ] || continue
  # The commits pushed, not what the working tree holds beside them, in a worktree, as the mutation
  # testing reads the lines changed from git.
  copy=$(mktemp -d)
  trap 'git worktree remove --force "$copy" 2>/dev/null; rm -rf "$copy"' EXIT
  git worktree add -q --detach "$copy" "$local"
  # git gives a hook the repository it runs for, such as GIT_DIR, which the git repositories the
  # tests make would take as theirs.
  (cd "$copy" && unset $(git rev-parse --local-env-vars) && sh dev/check.sh $plugins && sh dev/properties.sh $plugins && sh dev/mutate.sh --since "$base" $plugins)
  git worktree remove --force "$copy"
  # Removed, so the cleanup on exit, which stops the push where it fails, has nothing left to do.
  trap - EXIT
done
