#!/bin/sh
# Before a push, the checks of what the push changes, on the commits pushed: `sh dev/check.sh`, for
# each plugin `sh dev/changed.sh` names, or `sh dev/prose.sh` where it names none and the push
# changes Markdown; the property tests and the mutation testing, which check that the tests are
# enough, are CI's. Turned on in a clone by
# `git config core.hooksPath dev/githooks`, with uv on PATH, which sets up the check tools in the
# commits pushed from their uv.lock.
set -e

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-push: uv is not on PATH; install it" \
    "(https://docs.astral.sh/uv/getting-started/installation/), with which pre-push sets up the" \
    "check tools by \`uv sync --locked\`" >&2
  exit 1
fi
zero=0000000000000000000000000000000000000000
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue
  # Counted from the commit the branch is at on the remote, checked when it was pushed, or from
  # where a branch new there left main; CI counts from the commit before where its `tests` passed,
  # which only CI knows, else from where the branch left main too.
  if [ "$remote" = "$zero" ]; then
    base=$(git merge-base "$local" origin/main)
  else
    base=$remote
  fi
  plugins=$(sh dev/changed.sh "$base" "$local")
  if [ -n "$plugins" ]; then
    run="sh dev/check.sh $plugins"
  elif git diff --name-only "$base" "$local" -- '*.md' | grep -q .; then
    # Documents alone, which no plugin's check reads, are checked for plain English.
    run="sh dev/prose.sh"
  else
    continue
  fi
  # The commits pushed, not what the working tree holds beside them, in a worktree.
  copy=$(mktemp -d)
  trap 'git worktree remove --force "$copy" 2>/dev/null; rm -rf "$copy"' EXIT
  git worktree add -q --detach "$copy" "$local"
  # git gives a hook the repository it runs for, such as GIT_DIR, which the git repositories the
  # tests make would take as theirs.
  (cd "$copy" && unset $(git rev-parse --local-env-vars) \
    && uv sync --locked --group test-quality --quiet \
    && uv run --no-sync $run)
  git worktree remove --force "$copy"
  # Removed, so the cleanup on exit, which stops the push where it fails, has nothing left to do.
  trap - EXIT
done
