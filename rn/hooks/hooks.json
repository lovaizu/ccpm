{
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/userpromptexpansion.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart.py\""
          }
        ]
      }
    ]
  }
}
