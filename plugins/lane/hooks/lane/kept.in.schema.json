{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What Lane gives a plugin's kept adapter",
  "description": "A run picked up in a new conversation.",
  "type": "object",
  "required": [
    "run"
  ],
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "object",
      "required": [
        "skill",
        "words"
      ],
      "additionalProperties": false,
      "description": "The run: the skill that started it and the words typed after its command.",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "words": {
          "type": "string"
        }
      }
    }
  }
}
