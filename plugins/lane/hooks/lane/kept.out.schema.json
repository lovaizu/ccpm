{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What a plugin's kept adapter gives Lane",
  "description": "Each chain of the run that the plugin keeps, with its results in their order, from which the run goes on, a lane for each chain.",
  "type": "object",
  "required": [
    "chains"
  ],
  "additionalProperties": false,
  "properties": {
    "chains": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "role",
            "result"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
