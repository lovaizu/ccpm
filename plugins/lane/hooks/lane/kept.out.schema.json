{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What a plugin's kept adapter gives Lane",
  "description": "Each result that the plugin keeps of the run, in its order, from which the run goes on.",
  "type": "object",
  "required": [
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
