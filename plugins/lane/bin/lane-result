#!/usr/bin/env python3
"""lane-result <result>: reports the result of the subagent's run."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from report import report  # noqa: E402 - found beside this command, wherever Lane lies.

if __name__ == "__main__":
    sys.exit(report("result", sys.argv[1:]))
