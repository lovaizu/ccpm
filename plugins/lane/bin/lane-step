#!/usr/bin/env python3
"""lane-step <step>: reports the step done."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from report import report  # noqa: E402 - found beside this command, wherever Lane lies.

if __name__ == "__main__":
    sys.exit(report("step", sys.argv[1:]))
