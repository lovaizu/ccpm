{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lanes.json",
  "description": "What Lane laid in a plugin: the Lanes, the Routes, and the adapters of the Proposal that its caller approved, and the Laid. A Proposal takes the form of `#/definitions/proposal`, which lay.py types gives up. The guard's code, form.py, reads and writes it, as a laid plugin runs without lay.py.",
  "type": "object",
  "required": [
    "lanes",
    "routes",
    "adapters",
    "laid"
  ],
  "additionalProperties": false,
  "properties": {
    "lanes": {
      "$ref": "#/definitions/lanes"
    },
    "routes": {
      "$ref": "#/definitions/routes"
    },
    "adapters": {
      "$ref": "#/definitions/adapters"
    },
    "laid": {
      "description": "What Lane added to the plugin, so that a later Lane takes out its own words and keeps the user's.",
      "type": "object",
      "required": [
        "sentences"
      ],
      "additionalProperties": false,
      "properties": {
        "sentences": {
          "type": "array",
          "items": {
            "description": "One sentence that Lane added to a Step.",
            "type": "object",
            "required": [
              "file",
              "step",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "$ref": "#/definitions/file"
              },
              "step": {
                "$ref": "#/definitions/step"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "proposal": {
      "description": "The Lanes, the Routes, and the adapters that up proposes for one plugin.",
      "type": "object",
      "required": [
        "lanes",
        "routes",
        "adapters"
      ],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "$ref": "#/definitions/lanes"
        },
        "routes": {
          "$ref": "#/definitions/routes"
        },
        "adapters": {
          "$ref": "#/definitions/adapters"
        }
      }
    },
    "file": {
      "description": "The path of a file of the plugin, from the plugin's folder, such as `agents/writer.md`.",
      "type": "string",
      "minLength": 1
    },
    "step": {
      "description": "A Step's number in its file's `## Steps`.",
      "type": "integer",
      "minimum": 1
    },
    "lanes": {
      "type": "array",
      "items": {
        "description": "A rule of one lane type on one Step.",
        "type": "object",
        "required": [
          "role",
          "file",
          "step",
          "type",
          "args"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "description": "The skill or subagent whose Step it is, by its name.",
            "type": "string",
            "minLength": 1
          },
          "file": {
            "$ref": "#/definitions/file"
          },
          "step": {
            "$ref": "#/definitions/step"
          },
          "type": {
            "description": "The lane type, by the name that lay.py types gives.",
            "type": "string",
            "minLength": 1
          },
          "args": {
            "description": "The values that the lane type takes, by the names that lay.py types gives for it.",
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "description": "The moves of one skill after its start, a Result, a typed command, or another plugin's run it called.",
        "type": "object",
        "required": [
          "skill",
          "after",
          "moves"
        ],
        "additionalProperties": false,
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "description": "What the Route goes after.",
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "first"
                ],
                "additionalProperties": false,
                "properties": {
                  "first": {
                    "description": "The skill's start.",
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "role",
                  "result"
                ],
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "command"
                ],
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "description": "A command of the plugin's that the person types, such as a pause.",
                    "type": "string"
                  }
                }
              }
            ]
          },
          "moves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "One move that the Route makes due.",
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "start"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "start": {
                      "description": "A subagent to start, by its name.",
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "resume"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "resume": {
                      "description": "A subagent to resume by SendMessage, by its name.",
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "wait"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "wait": {
                      "description": "The command that the person is to type, or an empty string for their reply.",
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "no_more"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "no_more": {
                      "description": "The skill's own Result, given by result.py, after which it starts no more.",
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "adapters": {
      "description": "The adapters that the plugin's hooks/adapters/ holds, each by its path from the plugin's folder.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "The adapter that gives a start's text and run values.",
          "type": "string"
        },
        "records": {
          "description": "The adapter that gives the Kept results.",
          "type": "string"
        },
        "items": {
          "description": "The adapter that gives the Items of a Step's checklist.",
          "type": "string"
        }
      }
    }
  }
}
