        },
        {
          "id": "N3",
          "good": false,
          "decisions": []
        },
        {
          "id": "N4",
          "good": false,
          "decisions": [
            {
              "about": "The principles",
              "decided": "one for each idea of rn's concept, one for the throwaway copy, and one for the repository holding the work",
              "by": "reasoning"
            },
            {
              "about": "Drawn out along the design tree",
              "decided": "each role starts with its own cut of the design tree alone",
              "by": "user"
            },
            {
              "about": "Every step by best practice",
              "decided": "each role works by the best practice of its work, and Lane holds it to the steps",
              "by": "user"
            },
            {
              "about": "Judged by the people it's for",
              "decided": "an evaluator has only what the deliverable's people have",
              "by": "user"
            },
            {
              "about": "Back to the design tree on a problem",
              "decided": "a lack changes the decision it comes from, and the next round makes the deliverable from the design",
              "by": "user"
            },
            {
              "about": "The design tree revised on each run",
              "decided": "what a run finds changes the design tree before the next deliverable, and a best practice before the next run once the user takes the change",
              "by": "user"
            }
          ]
        },
        {
          "id": "N5",
          "good": false,
          "decisions": [
            {
              "about": "The orchestrator",
              "decided": "the main conversation, which talks with the user, runs the work, and makes every judgment and the final decision, and makes nothing itself",
              "by": "user"
            },
            {
              "about": "The orchestrator's judgments",
              "decided": "from the purpose and the best practices, never taking a role's result as given",
              "by": "user"
            },
            {
              "about": "The tree-keeper",
              "decided": "writes what the orchestrator decides into the design tree, checks the path up to the goal and each node the change touches, and drafts the plan again at each turn's end",
              "by": "user"
            },
            {
              "about": "Who writes the design tree",
              "decided": "the tree-keeper alone",
              "by": "user"
            },
            {
              "about": "Who settles a point",
              "decided": "the orchestrator, which asks the user only the points that are theirs",
              "by": "user"
            },
            {
              "about": "A point for the user",
              "decided": "one at a time, with a recommendation",
              "by": "user"
            },
            {
              "about": "A kind with no best practice",
              "decided": "the orchestrator plans one first, as a deliverable of its own, made by the meta best practice",
              "by": "user"
            },
            {
              "about": "What the generator does",
              "decided": "makes the deliverable from its cut and its best practice, checks it by the best practice's questions before it returns, and returns an open point instead of guessing",
              "by": "user"
            },
            {
              "about": "What an evaluator answers",
              "decided": "where each intent gives the people what they're after, or what would make it good",
              "by": "user"
            },
            {
              "about": "Judging a lack",
              "decided": "the orchestrator judges each lack by the purpose and the best practices, and keeps only one the people fall short by, as a change to the decision it comes from",
              "by": "user"
            },
            {
              "about": "A deliverable finished",
              "decided": "once every intent is good",
              "by": "user"
            },
            {
              "about": "Planning again",
              "decided": "at each turn's end, from the design tree",
              "by": "user"
            },
            {
              "about": "Messages with the tree-keeper",
              "decided": "the orchestrator and the tree-keeper talk by messages through the run",
              "by": "user"
            },
            {
              "about": "Messages with a generator",
              "decided": "the orchestrator resumes a generator only with the decision on its open point, or with a result sent back and its ground",
              "by": "user"
            },
            {
              "about": "Messages with an evaluator",
              "decided": "none, as the orchestrator only starts it",
              "by": "user"
            },
            {
              "about": "Changes to a best practice",
              "decided": "before the merge, the orchestrator proposes each change that the run's lacks call for",
              "by": "user"
            },
            {
              "about": "A change the user takes",
              "decided": "becomes a deliverable",
              "by": "user"
            },
            {
              "about": "A general lesson",
              "decided": "an issue on rn's repository, only when the user says yes, as N17 of the plugin best practice says",
              "by": "user"
            },
            {
              "about": "Commands only in a throwaway copy",
              "decided": "held by a lane of its own in Lane, as dev.md says of a check that no lane holds",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N6",
          "good": false,
          "decisions": []
        },
        {
          "id": "N7",
