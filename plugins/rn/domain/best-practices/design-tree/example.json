      "name": "rn's developers build its parts so that together they deliver its product vision",
      "path": "dev/rn/architecture.md",
      "kind": "architecture",
      "inputs": [
        "dev/rn/product-vision.md",
        "plugins/rn/README.md"
      ],
      "preconditions": [],
      "status": "doing",
      "necessary_conditions": [
        {
          "id": "N1",
          "good": false,
          "decisions": []
        },
        {
          "id": "N2",
          "good": false,
