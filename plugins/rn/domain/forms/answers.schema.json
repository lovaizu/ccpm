{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Answers",
  "description": "An evaluator's record of a round, evaluator-<group>.json in the round's folder: each intent of its group met, with the lines that meet it, or not met, with what the people still lack, and each point only the user can settle.",
  "type": "object",
  "required": [
    "met",
    "not_met",
    "open"
  ],
  "additionalProperties": false,
  "properties": {
    "met": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "The intent, by its ID.",
            "type": "string"
          },
          "lines": {
            "description": "Each line of the deliverable, of what it takes from, or of the try record that meets it, as it stands, so a reader checks the answer by reading them.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "not_met": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "lacks"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "The intent, by its ID.",
            "type": "string"
          },
          "lacks": {
            "description": "What the people still lack, in their terms, never how to make it.",
            "type": "string"
          }
        }
      }
    },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "about",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "The intent the point bears on, by its ID.",
            "type": "string"
          },
          "about": {
            "description": "What the point is about, in a few words.",
            "type": "string"
          },
          "what": {
            "description": "The point that only the user can settle.",
            "type": "string"
          }
        }
      }
    }
  }
}
