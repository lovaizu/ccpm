{
  "subagents": [
    {
      "name": "pinner",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{design}"
              ]
            },
            {
              "lane": "edit_only",
              "takes": [
                "{design}"
              ]
            },
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/check.py {design}"
              ]
            }
          ]
        },
        {
          "step": 3,
          "lanes": [
            {
              "lane": "test_after",
              "takes": [
                "{design}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/check.py {design}"
              ]
            }
          ]
        }
      ]
    }
  ],
  "routes": {
    "orchestrator": "down",
    "step": 2,
    "routes": [
      {
        "from": "down",
        "to": "pinner"
      },
      {
        "from": "pinner",
        "on": "asks",
        "waits": true
      },
      {
        "from": "pinner",
        "on": "done"
      }
    ]
  }
}
