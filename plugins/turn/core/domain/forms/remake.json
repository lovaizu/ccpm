{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "remake.json",
  "description": "The decisions builder makes again, each with the question, and what its user gets once it is good, that sent it back.",
  "type": "object",
  "required": ["decisions"],
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision", "question", "good_when"],
        "additionalProperties": false,
        "properties": {
          "decision": {"type": "string"},
          "question": {"type": "string"},
          "good_when": {"type": "string"}
        }
      }
    }
  }
}
