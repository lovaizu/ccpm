{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "standard",
  "description": "The Standard: a best practice's goal, parts and questions, without its ways of meeting them, which is all the evaluator is given.",
  "type": "object",
  "required": ["goal", "user_benefits"],
  "additionalProperties": false,
  "properties": {
    "goal": {"type": "string"},
    "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
    "user_benefits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "about", "what"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "about": {"type": "string"},
          "what": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": ["id", "what"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "what": {"type": "string"},
        "parts": {"type": "array", "items": {"$ref": "#/$defs/inner"}}
      }
    },
    "inner": {
      "description": "a part inside a part; structured outputs take no schema that comes back to itself, so parts nest three deep at most",
      "type": "object",
      "required": ["id", "what"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "what": {"type": "string"},
        "parts": {"type": "array", "items": {"$ref": "#/$defs/leaf"}}
      }
    },
    "leaf": {
      "type": "object",
      "required": ["id", "what"],
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "what": {"type": "string"}}
    }
  }
}
