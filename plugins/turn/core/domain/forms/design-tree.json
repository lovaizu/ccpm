{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-tree.json",
  "description": "What Turn reads of pin's design tree: its questions, and each decision's joins. pin's check.py holds it to the rest of its form.",
  "type": "object",
  "required": ["questions", "decisions"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "what"],
        "properties": {"id": {"type": "string"}, "what": {"type": "string"}}
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "contributes_to", "builds_on"],
        "properties": {
          "id": {"type": "string"},
          "contributes_to": {"type": "array", "items": {"type": "string"}},
          "builds_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
