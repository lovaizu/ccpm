{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "open",
  "description": "The points the design leaves open that bear on the work's quality, each with the question it bears on.",
  "type": "object",
  "required": ["open"],
  "additionalProperties": false,
  "properties": {
    "open": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question", "what"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string"},
          "what": {"type": "string"}
        }
      }
    }
  }
}
