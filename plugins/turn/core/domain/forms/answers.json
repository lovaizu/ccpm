{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "answers",
  "description": "The Answers of a run of the generator or of the evaluator: each question it was given, met, with the lines of the work that meet it, or not met, with what the user still lacks; and each point open, the generator's that the design leaves open, or, in a reading round, a change to what the work says.",
  "type": "object",
  "required": ["met", "not_met"],
  "additionalProperties": false,
  "properties": {
    "met": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "lines"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string"},
          "lines": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "not_met": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "lacks"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string"},
          "lacks": {"type": "string", "description": "what the work's user still lacks, in their terms, never how to make it"}
        }
      }
    },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "what"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string"},
          "what": {"type": "string"}
        }
      }
    }
  }
}
