{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "best practice",
  "description": "A kind's best practice: its goal; the template beside it that holds the form a good work of the kind takes, and the example beside it, one work made by it, each by its file's name, with the work the example is a copy of where it is one, by its path from the best practice's folder, or else the parts such a work has; the kinds such a work is made from, in inputs, and those whose works must pass before it is made, in preconditions, each by the name of its best practice's folder; the questions such a work answers yes to; and a way to make each question yes, its thinking what to do and why, and its steps where it needs them. The Standard is its goal, parts and questions alone.",
  "type": "object",
  "required": [
    "goal",
    "inputs",
    "preconditions",
    "intents",
    "practices"
  ],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "example": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "about": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "practices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "thinking",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string"
          },
          "thinking": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inner"
          }
        }
      }
    },
    "inner": {
      "description": "a part inside a part; structured outputs take no schema that comes back to itself, so parts nest three deep at most",
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leaf"
          }
        }
      }
    },
    "leaf": {
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        }
      }
    }
  }
}
