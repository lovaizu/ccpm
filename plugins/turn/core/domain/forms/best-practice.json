{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "best practice",
  "description": "A kind's best practice: its goal, the parts a good work of the kind has where no template beside it, <kind>-template.md, holds them, the questions such a work answers yes to, and a way to make each question yes. The Standard is its goal, parts and questions alone.",
  "type": "object",
  "required": [
    "goal",
    "benefits",
    "practices"
  ],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "benefits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "about": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "practices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "benefit",
          "thinking",
          "steps",
          "grounds"
        ],
        "additionalProperties": false,
        "properties": {
          "benefit": {
            "type": "string"
          },
          "thinking": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grounds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "by": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url",
                "by",
                "quote"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inner"
          }
        }
      }
    },
    "inner": {
      "description": "a part inside a part; structured outputs take no schema that comes back to itself, so parts nest three deep at most",
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leaf"
          }
        }
      }
    },
    "leaf": {
      "type": "object",
      "required": [
        "id",
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        }
      }
    }
  }
}
