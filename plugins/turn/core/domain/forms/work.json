{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "work.json",
  "description": "Where the work lies, what its user runs, and its parts, each made by a run of builder of its own.",
  "type": "object",
  "required": ["paths", "commands", "parts"],
  "additionalProperties": false,
  "properties": {
    "paths": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decisions", "paths"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "decisions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "paths": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
