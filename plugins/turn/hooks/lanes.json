{
  "subagents": [
    {
      "name": "planner",
      "steps": [
        {
          "step": 3,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${dependency:pin}/scripts/check.py {run}/kind-tree.json"
              ]
            }
          ]
        },
        {
          "step": 4,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{run}",
                ".turn/best-practices"
              ]
            }
          ]
        },
        {
          "step": 5,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/practices.py ready {run}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/practices.py ready {run}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "designer",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${dependency:pin}/scripts/check.py {run}/design-tree.json"
              ]
            },
            {
              "lane": "write_only",
              "takes": [
                "{run}"
              ]
            }
          ]
        },
        {
          "step": 3,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tree.py parts {run}"
              ]
            }
          ]
        },
        {
          "step": 4,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tree.py check {run}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tree.py check {run}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "builder",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{work}",
                "{answers}",
                "{open}"
              ]
            }
          ]
        },
        {
          "step": 2,
          "lanes": [
            {
              "lane": "in_form",
              "takes": [
                "{open}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/open.json"
              ]
            }
          ]
        },
        {
          "step": 3,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "{commands}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            },
            {
              "lane": "in_form",
              "takes": [
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/answers.json"
              ]
            },
            {
              "lane": "read_whole",
              "takes": [
                "{work}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{work}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "evaluator",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{answers}"
              ]
            },
            {
              "lane": "run_only",
              "takes": [
                "{commands}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            },
            {
              "lane": "in_form",
              "takes": [
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/answers.json"
              ]
            },
            {
              "lane": "read_whole",
              "takes": [
                "{work}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{answers}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "refactorer",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{work}",
                "{answers}"
              ]
            }
          ]
        },
        {
          "step": 2,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "{commands}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            },
            {
              "lane": "in_form",
              "takes": [
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/answers.json"
              ]
            },
            {
              "lane": "read_whole",
              "takes": [
                "{work}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{work}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "proofreader",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{answers}"
              ]
            },
            {
              "lane": "run_only",
              "takes": [
                "{commands}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            },
            {
              "lane": "in_form",
              "takes": [
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/answers.json"
              ]
            },
            {
              "lane": "read_whole",
              "takes": [
                "{work}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{answers}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/answers.py check {run} {answers}"
              ]
            }
          ]
        }
      ]
    }
  ],
  "routes": {
    "orchestrator": "up",
    "step": 2,
    "fan_out": [
      "builder",
      "evaluator",
      "proofreader"
    ],
    "precedence": {
      "builder": [
        "open",
        "built"
      ],
      "evaluator": [
        "more",
        "good"
      ],
      "proofreader": [
        "content",
        "more",
        "good"
      ]
    },
    "routes": [
      {
        "from": "up",
        "to": "planner"
      },
      {
        "from": "planner",
        "on": "planned",
        "to": "designer"
      },
      {
        "from": "planner",
        "on": "asks"
      },
      {
        "from": "designer",
        "on": "designed",
        "to": "builder"
      },
      {
        "from": "designer",
        "on": "asks"
      },
      {
        "from": "builder",
        "on": "built",
        "to": "evaluator"
      },
      {
        "from": "builder",
        "on": "open",
        "to": "designer"
      },
      {
        "from": "evaluator",
        "on": "more",
        "to": "designer"
      },
      {
        "from": "evaluator",
        "on": "good",
        "to": "refactorer"
      },
      {
        "from": "refactorer",
        "on": "refactored",
        "to": "proofreader"
      },
      {
        "from": "proofreader",
        "on": "more",
        "to": "refactorer"
      },
      {
        "from": "proofreader",
        "on": "content",
        "to": "designer"
      },
      {
        "from": "proofreader",
        "on": "good"
      }
    ]
  }
}
