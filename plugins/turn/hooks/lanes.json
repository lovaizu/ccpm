{
  "subagents": [
    {
      "name": "planner",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/plan.py check {run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/plan.py start {run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/plan.py hand {run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/plan.py ready {run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/plan.py next {run}"
              ]
            }
          ]
        },
        {
          "step": 2,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{run}"
              ]
            }
          ]
        },
        {
          "step": 7,
          "lanes": [
            {
              "lane": "test_after",
              "takes": [
                "{run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/plan.py check {run}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "generator",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/rounds.py round {run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/rounds.py check {run} {answers}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/throwaway.py {run}"
              ]
            }
          ]
        },
        {
          "step": 2,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{work}",
                "{answers}"
              ]
            }
          ]
        },
        {
          "step": 3,
          "lanes": [
            {
              "lane": "in_form",
              "takes": [
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/answers.json"
              ]
            },
            {
              "lane": "read_whole",
              "takes": [
                "{work}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{work}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/rounds.py check {run} {answers}"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{answers}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/rounds.py check {run} {answers}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "evaluator",
      "steps": [
        {
          "step": 1,
          "lanes": [
            {
              "lane": "read_only",
              "takes": [
                "{work}",
                "{standard}",
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/use-and-answer.md"
              ]
            },
            {
              "lane": "read_whole",
              "takes": [
                "{work}"
              ]
            },
            {
              "lane": "run_only",
              "takes": [
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/throwaway.py {run}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/rounds.py check {run} {answers}"
              ]
            }
          ]
        },
        {
          "step": 2,
          "lanes": [
            {
              "lane": "write_only",
              "takes": [
                "{answers}"
              ]
            },
            {
              "lane": "in_form",
              "takes": [
                "{answers}",
                "${CLAUDE_PLUGIN_ROOT}/core/domain/forms/answers.json"
              ]
            },
            {
              "lane": "test_after",
              "takes": [
                "{answers}",
                "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/rounds.py check {run} {answers}"
              ]
            }
          ]
        }
      ]
    }
  ],
  "routes": {
    "orchestrator": "up",
    "step": 2,
    "fan_out": [
      "evaluator"
    ],
    "precedence": {
      "evaluator": [
        "more",
        "reword",
        "met",
        "good"
      ]
    },
    "routes": [
      {
        "from": "up",
        "to": "planner"
      },
      {
        "from": "planner",
        "on": "asks"
      },
      {
        "from": "planner",
        "on": "handed",
        "to": "pin:pinner"
      },
      {
        "from": "planner",
        "on": "ready",
        "to": "generator"
      },
      {
        "from": "planner",
        "on": "done"
      },
      {
        "from": "pin:pinner",
        "on": "asks"
      },
      {
        "from": "pin:pinner",
        "on": "done",
        "to": "planner"
      },
      {
        "from": "generator",
        "on": "made",
        "to": "evaluator"
      },
      {
        "from": "generator",
        "on": "open",
        "to": "planner"
      },
      {
        "from": "evaluator",
        "on": "more",
        "to": "planner"
      },
      {
        "from": "evaluator",
        "on": "met",
        "to": "generator"
      },
      {
        "from": "evaluator",
        "on": "reword",
        "to": "generator"
      },
      {
        "from": "evaluator",
        "on": "good",
        "to": "planner"
      }
    ]
  }
}
