  {
   "name": "overnight's developers know whom overnight serves and the one way it brings them the night's results in the morning",
   "path": "dev/overnight/product-vision.md",
   "kind": "product-vision",
   "inputs": [],
   "status": "open",
   "necessary_conditions": [
