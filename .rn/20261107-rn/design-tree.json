          "decisions": [
            {
              "about": "A turn",
              "decided": "once the main conversation settles a deliverable's decisions, a turn makes it from them and its kind's best practice until every intent is good, or a point only the user can settle stops it",
              "by": "user"
            },
            {
              "about": "Good from the root",
              "decided": "a shortfall goes back to the decision that serves it, and the next round makes the deliverable from the design, never a fix beside it",
              "by": "user"
            },
            {
              "about": "A remark during a turn",
              "decided": "a remark during a turn is a point: the main conversation settles it into the tree, and the turn goes on from the changed design. No one adds it to a running role",
              "by": "user"
            },
            {
              "about": "The maker checks first",
              "decided": "the generator reads the deliverable as its people before it hands it on. Only the evaluators make an intent good",
              "by": "reasoning"
            },
            {
              "about": "The evaluator seeks the good",
              "decided": "an evaluator reads as the deliverable's people and confirms where each intent gives them what they're after. It names a lack only where they would fall short of their aim",
              "by": "user"
            },
            {
              "about": "The designer judges the evaluators",
              "decided": "the main conversation judges each lack an evaluator names by the purpose before anything changes: whether the people fall short without it, and whether it's an intent or only how a part works inside. Only a lack of intent goes on",
              "by": "user"
            },
            {
              "about": "Intent, not spec",
              "decided": "the design tree and the architecture hold intent only. The maker of a part settles how it works inside, where they build it",
              "by": "user"
            }
          ]
